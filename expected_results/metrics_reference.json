{
  "schema_version": 1,
  "definitions": {
    "ntu_mae": "mean(abs(pred_ntu - target_ntu))",
    "ntu_rmse": "sqrt(mean((pred_ntu - target_ntu)^2))",
    "split_ntu_mape": "mean(min(abs(pred_ntu-target_ntu)/(target_ntu+1)*100, 1000)); cap each percentage before averaging",
    "group_ntu_mape": "mean(abs(pred_ntu-target_ntu)/(target_ntu+1)*100); uncapped convention specified by the current source",
    "archived_group_zero_offset_mape_diagnostic": "mean(abs(pred_ntu-target_ntu)/target_ntu*100); uncapped, separate from the released target+1 group MAPE",
    "r2": "1 - sum((target_ntu-pred_ntu)^2)/sum((target_ntu-mean(target_ntu))^2); historical constant-target convention returns 1 when denominator is zero"
  },
  "numeric_scope": "Recompute from the released NTU values using Python binary64 and math.fsum. No log-space transformation, training, or inference is performed.",
  "reference_roles": {
    "historical_float32_split_metrics": "Independent original stage1_best_metrics.json values for validation and test only. Its float32 transformations/reductions differ slightly from aggregation of the exported NTU columns.",
    "archived_table_float64_split_metrics": "Independent archived all-split figure-source summary table: MAE and RMSE for train, validation, and test. This is not a claim about the paper's published full-precision values.",
    "archived_zero_offset_group_metrics": "Independent original val_group_summary.csv and test_group_summary.csv MAE and MAPE for the three held-out groups. The archived MAPE numerically matches a target-only denominator (zero offset), although the current archived evaluation source specifies target+1. The producing code version is not established. These values are checked as a separate zero-offset diagnostic and are not asserted to equal the released target+1 group MAPE.",
    "exported_float64_split_metrics": "Frozen recalculation from the minimized prediction export; a regression reference, not an independent historical stage1 result. Train MAPE and R2 have this role only.",
    "exported_float64_group_metrics": "Frozen target+1, uncapped per-group recalculation from the minimized prediction export; a regression reference. Archived group MAE and zero-offset MAPE diagnostics are checked separately where available."
  },
